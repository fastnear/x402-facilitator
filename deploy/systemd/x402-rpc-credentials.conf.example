# Optional instance-local drop-in for authenticated RPC endpoints.
#
# Install only the entries that have a matching root-owned mode-0600 source
# file. For example:
#   /etc/systemd/system/x402-near-facilitator@base.service.d/rpc-credentials.conf
#
# The credential value is one complete HTTPS URL followed by one newline.
[Service]
LoadCredential=primary-rpc-url:/etc/x402-near-facilitator/credentials/%i/primary-rpc-url
Environment=PRIMARY_RPC_URL_FILE=%d/primary-rpc-url

# Add a second independent provider when its URL is also secret:
# LoadCredential=backup-rpc-url:/etc/x402-near-facilitator/credentials/%i/backup-rpc-url
# Environment=BACKUP_RPC_URL_FILE=%d/backup-rpc-url
