# /etc/x402-demo/base.env — mode 0640 root:x402-demo-base.
# The API key file itself must be mode 0600, owned by x402-demo-base.
FACILITATOR_URL=https://base.x402.mikedotexe.com
FACILITATOR_API_KEY_FILE=/etc/x402-demo/credentials/base/api-key
NETWORK=eip155:8453
# Base mainnet Circle USDC (the exact ERC-20 the facilitator client is
# allowlisted for).
ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# The token's own EIP-712 domain (ERC-3009 signing). For Base USDC this is
# name "USD Coin", version "2" — NOT the "USDC" symbol.
ASSET_EIP712_NAME=USD Coin
ASSET_EIP712_VERSION=2
# The merchant EVM address the facilitator client is allowlisted to pay.
PAY_TO=0x7Ff46ab88688D528bCE3e59c470240c6901cF88c
AMOUNT=1000
PORT=4023
